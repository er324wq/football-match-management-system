# Copy these values into your shell environment and replace every placeholder.
# Spring Boot does not load .env files automatically.
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_ONE_TIME_ADMIN_PASSWORD
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:8085
